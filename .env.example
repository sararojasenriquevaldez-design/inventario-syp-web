# =============================================================================
# inventario-syp-web — variables de entorno de DESARROLLO
# Copia este archivo como .env (Copy-Item .env.example .env). El .env no se sube a git.
#
# IMPORTANTE: el frontend NO tiene secretos. Todo lo que empiece con VITE_ queda visible
# en el navegador de cualquier usuario: nunca pongas claves, contraseñas ni tokens aquí.
# =============================================================================

# Destino del proxy de Vite para /api en `pnpm run dev` (la API local). No llega al navegador.
API_PROXY_TARGET=http://localhost:3000
