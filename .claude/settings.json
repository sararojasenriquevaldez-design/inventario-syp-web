{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm run lint *)",
      "Bash(pnpm run lint:fix *)",
      "Bash(pnpm run format *)",
      "Bash(pnpm run test *)",
      "Bash(pnpm run test:cov *)",
      "Bash(pnpm run test:e2e *)",
      "Bash(pnpm run build *)",
      "Bash(pnpm run revisar:datos *)",
      "Bash(pnpm run api:tipos *)",
      "Bash(pnpm test *)",
      "Bash(pnpm ls *)",
      "Bash(pnpm why *)",
      "Bash(pnpm outdated *)",
      "Bash(pnpm audit *)",
      "Bash(pnpm exec tsc *)",
      "Bash(pnpm exec vitest *)",
      "Bash(pnpm exec oxlint *)",
      "Bash(pnpm exec prettier *)",
      "Bash(pnpm exec playwright test *)",
      "Bash(npm view *)",
      "Bash(node scripts/revisar-datos-publicos.mjs *)",
      "Bash(node .claude/hooks/probar-hooks.mjs *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git remote -v)",
      "PowerShell(pnpm run lint *)",
      "PowerShell(pnpm run lint:fix *)",
      "PowerShell(pnpm run format *)",
      "PowerShell(pnpm run test *)",
      "PowerShell(pnpm run test:cov *)",
      "PowerShell(pnpm run test:e2e *)",
      "PowerShell(pnpm run build *)",
      "PowerShell(pnpm run revisar:datos *)",
      "PowerShell(pnpm run api:tipos *)",
      "PowerShell(pnpm test *)",
      "PowerShell(pnpm ls *)",
      "PowerShell(pnpm why *)",
      "PowerShell(pnpm outdated *)",
      "PowerShell(pnpm audit *)",
      "PowerShell(pnpm exec tsc *)",
      "PowerShell(pnpm exec vitest *)",
      "PowerShell(pnpm exec oxlint *)",
      "PowerShell(pnpm exec prettier *)",
      "PowerShell(pnpm exec playwright test *)",
      "PowerShell(npm view *)",
      "PowerShell(node scripts/revisar-datos-publicos.mjs *)",
      "PowerShell(node .claude/hooks/probar-hooks.mjs *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git branch --show-current)",
      "PowerShell(git branch --list *)",
      "PowerShell(git show *)",
      "PowerShell(git rev-parse *)",
      "PowerShell(git ls-files *)",
      "PowerShell(git remote -v)"
    ],
    "ask": [
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Edit(/pnpm-workspace.yaml)",
      "Edit(/vercel.json)",
      "Edit(/infra/**)",
      "Edit(/package.json)",
      "Edit(/CLAUDE.md)",
      "Edit(/.claude/skills/**)",
      "Edit(/.claude/agents/**)",
      "Edit(/.claude/rules/**)",
      "Edit(/scripts/**)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(*.pem)",
      "Read(*.key)",
      "Edit(/src/api/esquema.d.ts)",
      "Edit(/pnpm-lock.yaml)",
      "Edit(/docs/archivos-revisados.txt)",
      "Edit(/.claude/hooks/**)",
      "Edit(/.claude/settings.json)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm ci *)",
      "Bash(npm add *)",
      "Bash(npm uninstall *)",
      "Bash(yarn *)",
      "Bash(npx *)",
      "Bash(pnpm approve-builds *)",
      "Bash(pnpm self-update *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "PowerShell(npm install *)",
      "PowerShell(npm i *)",
      "PowerShell(npm ci *)",
      "PowerShell(npm add *)",
      "PowerShell(npm uninstall *)",
      "PowerShell(yarn *)",
      "PowerShell(npx *)",
      "PowerShell(pnpm approve-builds *)",
      "PowerShell(pnpm self-update *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/proteger-archivos.mjs"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/proteger-lectura.mjs"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/vigilar-comandos.mjs"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
